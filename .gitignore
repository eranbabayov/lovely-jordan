# Original photos — personal, large, and rebuilt into public/images by the
# image pipeline. Never tracked.
/images/

# PLAINTEXT gift content. Committing this defeats CAP-5 silently and puts the
# entire surprise one `git log` away. See the spec's threat-model.md.
/gifts-src/

# PLAINTEXT gate answers. Holding these lets anyone derive the gift key and
# open everything, so they are the same category of secret as gifts-src/.
# Only the SHA-256 digests belong in version control (src/config.ts).
/secrets/

# Build output
/dist/
/public/images/
/public/gifts/

# Dependencies
node_modules/

# Env / local
.env
.env.local
*.local

# OS / editor noise
Thumbs.db
ehthumbs.db
Desktop.ini
.DS_Store
*.swp
